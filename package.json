{
  "name": "@your-scope/graphkit",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": {
      "types": "./dist/react/styles.css.d.ts",
      "default": "./dist/react/styles.css"
    }
  },
  "scripts": {
    "build": "tsc && cp src/react/styles.css src/react/styles.css.d.ts dist/react/",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "d3-selection": "^3.0.0",
    "d3-drag": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/d3-selection": "^3",
    "@types/d3-drag": "^3",
    "@types/d3-zoom": "^3",
    "@biomejs/biome": "^2",
    "jsdom": "^27"
  },
  "sideEffects": [
    "./dist/react/styles.css"
  ]
}
